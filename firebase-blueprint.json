{
  "entities": {
    "HtmlTemplate": {
      "title": "HTML Template",
      "description": "A manually uploaded HTML template for hosting",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the template slug"
        },
        "name": {
          "type": "string",
          "description": "User-friendly name"
        },
        "htmlContent": {
          "type": "string",
          "description": "The raw HTML content"
        },
        "cssContent": {
          "type": "string",
          "description": "Optional CSS for the template"
        },
        "jsContent": {
          "type": "string",
          "description": "Optional JS for the template"
        },
        "category": {
          "type": "string",
          "description": "e.g. Birthday, Wish, Landing Page"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "htmlContent",
        "createdAt"
      ]
    },
    "PaynicornOrder": {
      "title": "Paynicorn Order",
      "description": "An order processed via Paynicorn payment gateway",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Unique identifier for the order"
        },
        "amount": {
          "type": "number",
          "description": "Amount in payment currency"
        },
        "currency": {
          "type": "string",
          "description": "Currency of payment (e.g. BDT)"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "PAID", "FAILED", "CANCELLED"],
          "description": "Order processing status"
        },
        "userId": {
          "type": "string",
          "description": "Identifier of the ordering user"
        },
        "userEmail": {
          "type": "string",
          "description": "Email of user"
        },
        "paymentUrl": {
          "type": "string",
          "description": "Checkout or payment URL"
        },
        "tradeNo": {
          "type": "string",
          "description": "Paynicorn trade number"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "orderId",
        "amount",
        "status"
      ]
    },
    "SmmService": {
      "title": "SMM Service",
      "description": "An automated SMM panel service synced from external providers",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Service identifier"
        },
        "name": {
          "type": "string",
          "description": "Service title"
        },
        "category": {
          "type": "string",
          "description": "Platform or service category"
        },
        "price": {
          "type": "number",
          "description": "Selling price per 1000 units with profit margin"
        },
        "originalPrice": {
          "type": "number",
          "description": "Provider API base cost"
        },
        "min": {
          "type": "number",
          "description": "Minimum order quantity"
        },
        "max": {
          "type": "number",
          "description": "Maximum order quantity"
        },
        "providerId": {
          "type": "string",
          "description": "Identifier of the external provider"
        },
        "providerServiceId": {
          "type": "string",
          "description": "Service ID at provider"
        },
        "disabled": {
          "type": "boolean",
          "description": "Whether service is disabled"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "price"
      ]
    },
    "SmmOrder": {
      "title": "SMM Order",
      "description": "A customer SMM order record",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Order ID"
        },
        "userEmail": {
          "type": "string",
          "description": "Customer email"
        },
        "serviceName": {
          "type": "string",
          "description": "Name of ordered service"
        },
        "link": {
          "type": "string",
          "description": "Target social media URL"
        },
        "quantity": {
          "type": "number",
          "description": "Ordered count"
        },
        "charge": {
          "type": "number",
          "description": "Amount charged to user"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "In progress", "Completed", "Partial", "Canceled", "Processing"],
          "description": "Order fulfillment status"
        }
      },
      "required": [
        "id",
        "userEmail",
        "link",
        "quantity"
      ]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "PaynicornOrder",
      "description": "Paynicorn payment orders collection"
    },
    "/templates/{templateId}": {
      "schema": "HtmlTemplate",
      "description": "Collection of hosted HTML templates"
    },
    "/site/{docId}": {
      "schema": "object",
      "description": "Production website details and live systems maintenance controls"
    },
    "/maintenance/{docId}": {
      "schema": "object",
      "description": "Global website maintenance controls and maintenanceMode state"
    },
    "/dih_v3_users/{docId}": {
      "schema": "object",
      "description": "Database of registered suite users"
    },
    "/dih_v3_settings/{docId}": {
      "schema": "object",
      "description": "Global custom backup settings"
    },
    "/dih_v3_store/{docId}": {
      "schema": "object",
      "description": "App store item catalog"
    },
    "/dih_v3_logs/{docId}": {
      "schema": "object",
      "description": "Activity audit logs"
    },
    "/dih_v3_migrations/{docId}": {
      "schema": "object",
      "description": "Data and schema migration tracking records"
    },
    "/dih_v3_hostinger/{docId}": {
      "schema": "object",
      "description": "Hostinger dynamic site manager configurations"
    },
    "/users/{userId}": {
      "schema": "object",
      "description": "User profile with balance and subscription info"
    },
    "/test/{docId}": {
      "schema": "object",
      "description": "Test connection document"
    }
  }
}
